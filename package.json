{
  "name": "weaver-next",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "next@16.2.10": {
      "postcss": "8.5.16"
    }
  },
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "build:packages": "npm --workspace @weaver/contracts run build && npm --workspace @weaver/core run build && npm --workspace @weaver/layout-engine run build && npm --workspace @weaver/scene-packs run build && npm --workspace @weaver/visual-templates run build && npm --workspace @weaver/storage run build && npm --workspace @weaver/mcp run build",
    "build:widget": "npm --workspace @weaver/widget run build",
    "build:plugin": "npm run build:packages && npm run build:widget",
    "build:release": "npm run build:plugin && node scripts/build-plugin-release.mjs",
    "check:release": "node scripts/check-plugin-release.mjs",
    "probe:release": "WEAVER_PROBE_CWD=plugins/weaver-next WEAVER_PROBE_ARGS='[\"./scripts/start-mcp.mjs\"]' node scripts/probe-mcp.mjs",
    "capture:readme": "node scripts/capture-readme-assets.mjs",
    "dev:codex-plugin": "npm run build:plugin && node scripts/start-mcp-dev.mjs",
    "install:claude-skills": "node scripts/install-claude-skills.mjs",
    "typecheck:widget": "npm --workspace @weaver/widget run typecheck",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test:ts": "vitest run",
    "test:python": ".venv/bin/python -m pytest apps/api/tests",
    "benchmark:layout": "npm run build:packages && node scripts/benchmark-layout.mjs",
    "test": "npm run test:ts && npm run test:python",
    "dev:api": ".venv/bin/python -m uvicorn weaver_api.main:app --app-dir apps/api --reload --port 8000",
    "dev": "npm-run-all --parallel dev:api dev:web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
