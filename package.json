{
  "name": "weaver-next",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "test": ".venv/bin/python -m pytest apps/api/tests",
    "dev:api": ".venv/bin/python -m uvicorn weaver_api.main:app --app-dir apps/api --reload --port 8000",
    "dev": "npm-run-all --parallel dev:api dev:web"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
